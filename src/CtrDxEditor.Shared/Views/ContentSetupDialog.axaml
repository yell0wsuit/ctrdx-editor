<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:CtrDxEditor.Localization"
             xmlns:vm="using:CtrDxEditor.ViewModels"
             x:Class="CtrDxEditor.Views.ContentSetupDialog"
             x:DataType="vm:ContentSetupViewModel">
  <StackPanel Margin="24" Spacing="16" Width="500">
    <!-- Title reflects the current phase. -->
    <TextBlock FontSize="18" FontWeight="SemiBold" IsVisible="{Binding !IsBusy}"
               Text="{loc:Tr Dialog.ContentSetup.Title}" />
    <TextBlock FontSize="18" FontWeight="SemiBold" IsVisible="{Binding IsDownloading}"
               Text="{loc:Tr Dialog.ContentSetup.TitleDownloading}" />
    <TextBlock FontSize="18" FontWeight="SemiBold" IsVisible="{Binding IsInstallingZip}"
               Text="{loc:Tr Dialog.ContentSetup.TitleInstallingZip}" />

    <!-- Idle: describe the choice. -->
    <TextBlock TextWrapping="Wrap" IsVisible="{Binding !IsBusy}"
               Text="{loc:Tr Dialog.ContentSetup.Description}" />

    <!-- Downloading: live byte-based progress plus a cancel action (the download supports cancellation). -->
    <StackPanel Spacing="8" IsVisible="{Binding IsDownloading}">
      <TextBlock Text="{Binding Progress, StringFormat={loc:Tr Dialog.ContentSetup.Downloading}}" />
      <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" />
      <Button Content="{loc:Tr Dialog.ContentSetup.Cancel}" Click="Cancel_Click" HorizontalAlignment="Right" />
    </StackPanel>

    <!-- Installing a picked zip: no byte-level progress signal and nothing cancellable, so an
         indeterminate spinner with no Cancel button (a determinate bar or a live Cancel button
         would both be misleading here). -->
    <StackPanel Spacing="8" IsVisible="{Binding IsInstallingZip}">
      <TextBlock Text="{loc:Tr Dialog.ContentSetup.InstallingZip}" />
      <ProgressBar IsIndeterminate="True" />
    </StackPanel>

    <TextBlock Foreground="#E06C75" TextWrapping="Wrap"
               Text="{Binding ErrorMessage}"
               IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                IsVisible="{Binding !IsBusy}">
      <Button Content="{loc:Tr Dialog.ContentSetup.Download}" Classes="accent" Command="{Binding DownloadCommand}" />
      <Button Content="{loc:Tr Dialog.ContentSetup.DownloadManually}" Click="DownloadManually_Click" />
      <Button Content="{loc:Tr Dialog.ContentSetup.PickZip}" Click="PickZip_Click" IsEnabled="{Binding !IsBusy}" />
      <Button Content="{loc:Tr Dialog.Common.Quit}" Click="Quit_Click" IsVisible="{Binding AllowQuit}" />
    </StackPanel>
  </StackPanel>
</UserControl>
