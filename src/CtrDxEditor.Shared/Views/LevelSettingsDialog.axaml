<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CtrDxEditor.ViewModels"
             xmlns:loc="using:CtrDxEditor.Localization"
             xmlns:dlgconv="using:CtrDxEditor.Converters"
             xmlns:ctrl="using:CtrDxEditor.Controls"
             xmlns:icons="using:Material.Icons.Avalonia"
             x:Class="CtrDxEditor.Views.LevelSettingsDialog"
             x:DataType="vm:LevelSettingsViewModel">

  <UserControl.Styles>
    <Style Selector="RadioButton.PickerCard">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />

      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- Base card surface. -->
    <Style Selector="RadioButton.PickerCard Border.card-surface">
      <Setter Property="Background" Value="{DynamicResource EditorBrush.Surface.Card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EditorBrush.Surface.Divider}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Hover state. -->
    <Style Selector="RadioButton.PickerCard:pointerover Border.card-surface">
      <Setter Property="Background" Value="{DynamicResource EditorBrush.Surface.CardHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EditorBrush.Primary}" />
    </Style>

    <!-- Pressed state. -->
    <Style Selector="RadioButton.PickerCard:pressed Border.card-surface">
      <Setter Property="Background" Value="{DynamicResource EditorBrush.Surface.CardPressed}" />
    </Style>

    <!-- Selected state. -->
    <Style Selector="RadioButton.PickerCard:checked Border.card-surface">
      <Setter Property="Background" Value="{DynamicResource EditorBrush.PrimaryLow}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EditorBrush.Primary}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- Hidden by default; shown only on checked cards. -->
    <Style Selector="RadioButton.PickerCard Border.selected-badge">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="RadioButton.PickerCard:checked Border.selected-badge">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Slightly brighten preview when hovering. -->
    <Style Selector="RadioButton.PickerCard:pointerover Border.preview-frame">
      <Setter Property="Opacity" Value="0.95" />
    </Style>

  </UserControl.Styles>

  <Grid Margin="24" RowDefinitions="Auto,*,Auto"
        Width="{Binding $parent[TopLevel].Bounds.Width,
                Converter={x:Static dlgconv:DialogSizeConverter.Clamp}, ConverterParameter=360}"
        MaxHeight="{Binding $parent[TopLevel].Bounds.Height,
                    Converter={x:Static dlgconv:DialogSizeConverter.Clamp}, ConverterParameter=640}">
    <TextBlock x:Name="TitleText"
               Grid.Row="0"
               FontSize="18"
               FontWeight="SemiBold"
               Margin="0,0,0,12" />

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="12">

        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{loc:Tr Dialog.LevelSettings.Resolution}"
                       VerticalAlignment="Center" />
            <ctrl:HelpButton Header="{loc:Tr Dialog.LevelSettings.Resolution}"
                             Message="{loc:Tr Dialog.LevelSettings.ResolutionDescription}" />
          </StackPanel>

          <ComboBox ItemsSource="{Binding Presets}"
                    SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ResolutionPreset">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <!-- The manual W×H inputs only appear when the "Custom…" preset is selected. -->
          <Grid ColumnDefinitions="*,Auto,*"
                RowDefinitions="Auto,Auto"
                Margin="0,4,0,0"
                IsVisible="{Binding IsCustom}">
            <!-- Minimum is 0 rather than the real 320 so a longer number can be typed a digit at a
                 time; the actual bound is enforced by CanConfirm and reported below the box. -->
            <ctrl:NumericTextBox Grid.Row="0"
                                 Grid.Column="0"
                                 Minimum="0"
                                 Maximum="9999"
                                 Text="{Binding CustomWidthText, Mode=TwoWay}" />

            <TextBlock Grid.Row="0"
                       Grid.Column="1"
                       Text="x"
                       VerticalAlignment="Center"
                       Margin="8,0" />

            <ctrl:NumericTextBox Grid.Row="0"
                                 Grid.Column="2"
                                 Minimum="0"
                                 Maximum="9999"
                                 Text="{Binding CustomHeightText, Mode=TwoWay}" />

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="{Binding CustomWidthError}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource EditorBrush.DangerText}"
                       FontSize="12"
                       Margin="0,2,0,0"
                       IsVisible="{Binding HasCustomWidthError}" />

            <TextBlock Grid.Row="1"
                       Grid.Column="2"
                       Text="{Binding CustomHeightError}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource EditorBrush.DangerText}"
                       FontSize="12"
                       Margin="0,2,0,0"
                       IsVisible="{Binding HasCustomHeightError}" />
          </Grid>
        </StackPanel>

        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{loc:Tr Dialog.LevelSettings.RopePhysicsSpeed}"
                       VerticalAlignment="Center" />
            <ctrl:HelpButton Header="{loc:Tr Dialog.LevelSettings.RopePhysicsSpeed}"
                             Message="{loc:Tr Dialog.LevelSettings.RopePhysicsSpeedDescription}" />
          </StackPanel>

          <!-- Negatives are permitted (DX parses them without clamping), though only positive speeds are meaningful. -->
          <ctrl:NumericTextBox Minimum="-100"
                               Maximum="100"
                               AcceptDecimal="True"
                               Text="{Binding RopePhysicsSpeedText, Mode=TwoWay}" />

          <TextBlock Text="{Binding RopePhysicsSpeedError}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource EditorBrush.DangerText}"
                     FontSize="12"
                     IsVisible="{Binding HasRopePhysicsSpeedError}" />
        </StackPanel>

        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{loc:Tr Dialog.LevelSettings.Special}"
                       VerticalAlignment="Center" />
            <ctrl:HelpButton Header="{loc:Tr Dialog.LevelSettings.Special}"
                             Message="{loc:Tr Dialog.LevelSettings.SpecialDescription}" />
          </StackPanel>

          <ComboBox ItemsSource="{Binding SpecialOptions}"
                    SelectedItem="{Binding SelectedSpecial, Mode=TwoWay}"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SpecialOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <!-- The manual value input only appears when the "Custom…" option is selected. -->
          <StackPanel Spacing="2"
                      IsVisible="{Binding IsSpecialCustom}">
            <ctrl:NumericTextBox Minimum="0"
                                 Maximum="99"
                                 Text="{Binding CustomSpecialText, Mode=TwoWay}" />

            <TextBlock Text="{Binding CustomSpecialError}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource EditorBrush.DangerText}"
                       FontSize="12"
                       IsVisible="{Binding HasCustomSpecialError}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <CheckBox Content="{loc:Tr Dialog.LevelSettings.HalfCandy}"
                      IsChecked="{Binding TwoParts, Mode=TwoWay}"
                      IsEnabled="{Binding FlagsEditable}" />
            <ctrl:HelpButton Header="{loc:Tr Dialog.LevelSettings.HalfCandy}"
                             Message="{loc:Tr Dialog.LevelSettings.HalfCandyDescription}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="4">
            <CheckBox Content="{loc:Tr Dialog.LevelSettings.NightLevel}"
                      IsChecked="{Binding NightLevel, Mode=TwoWay}"
                      IsEnabled="{Binding FlagsEditable}" />
            <ctrl:HelpButton Header="{loc:Tr Dialog.LevelSettings.NightLevel}"
                             Message="{loc:Tr Dialog.LevelSettings.NightLevelDescription}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="4">
            <CheckBox Content="{loc:Tr Dialog.LevelSettings.MobilePhysics}"
                      IsChecked="{Binding UseMobilePhysics, Mode=TwoWay}"
                      IsEnabled="{Binding FlagsEditable}" />
            <ctrl:HelpButton Header="{loc:Tr Dialog.LevelSettings.MobilePhysics}"
                             Message="{loc:Tr Dialog.LevelSettings.MobilePhysicsDescription}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{loc:Tr Dialog.LevelSettings.Water}"
                       VerticalAlignment="Center" />
            <ctrl:HelpButton Header="{loc:Tr Dialog.LevelSettings.Water}"
                             Message="{loc:Tr Dialog.LevelSettings.WaterDescription}" />
          </StackPanel>
          <ctrl:NumericTextBox Minimum="0"
                               Maximum="10000"
                               AcceptDecimal="True"
                               Text="{Binding WaterText, Mode=TwoWay}" />

          <TextBlock Text="{Binding WaterError}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource EditorBrush.DangerText}"
                     FontSize="12"
                     IsVisible="{Binding HasWaterError}" />

          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{loc:Tr Dialog.LevelSettings.WaterSpeed}"
                       VerticalAlignment="Center" />
            <ctrl:HelpButton Header="{loc:Tr Dialog.LevelSettings.WaterSpeed}"
                             Message="{loc:Tr Dialog.LevelSettings.WaterSpeedDescription}" />
          </StackPanel>
          <ctrl:NumericTextBox Minimum="0"
                               Maximum="10000"
                               AcceptDecimal="True"
                               Text="{Binding WaterSpeedText, Mode=TwoWay}" />

          <TextBlock Text="{Binding WaterSpeedError}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource EditorBrush.DangerText}"
                     FontSize="12"
                     IsVisible="{Binding HasWaterSpeedError}" />

          <TextBlock Text="{Binding WaterDrainHint}"
                     TextWrapping="Wrap"
                     Opacity="0.7"
                     IsVisible="{Binding HasWaterDrainHint}" />
        </StackPanel>

        <!-- Editor-decoration pickers, shown in both New and Edit modes. -->
        <StackPanel Spacing="8">

          <Border Height="1"
                  Background="{DynamicResource EditorBrush.Surface.Divider}"
                  Margin="0,8,0,4" />

          <TextBlock Text="{loc:Tr Dialog.LevelSettings.CustomizationOptions}"
                      FontSize="16"
                      FontWeight="SemiBold"
                      Opacity="0.9"
                      Margin="0,0,0,2" />

          <Expander Header="{loc:Tr Dialog.LevelSettings.RopeColor}"
                    IsExpanded="False"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
            <Border Padding="2,8,2,2">
              <ItemsControl ItemsSource="{Binding RopeSkinOptions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RopeSkinOption">
                    <RadioButton Classes="PickerCard"
                                 GroupName="RopeSkin"
                                 IsChecked="{Binding IsSelected, Mode=TwoWay}">

                      <Grid Width="96">
                        <Border Classes="card-surface"
                                Padding="8"
                                CornerRadius="10">
                          <StackPanel Spacing="7">

                            <Border Classes="preview-frame"
                                    Height="36"
                                    CornerRadius="7"
                                    Background="{DynamicResource EditorBrush.Surface.Preview}"
                                    ClipToBounds="True">
                              <Panel>
                                <ctrl:RopeSwatch Width="76"
                                                  Height="28"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  IsVisible="{Binding !IsRandom}"
                                                  Skin="{Binding Id}" />
                                <icons:MaterialIcon Kind="DiceMultiple"
                                                    Width="24"
                                                    Height="24"
                                                    Foreground="{DynamicResource EditorBrush.Text.Subtle}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding IsRandom}" />
                              </Panel>
                            </Border>

                            <TextBlock Text="{Binding Label}"
                                       FontSize="12"
                                       LineHeight="14"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       MinHeight="30" />

                          </StackPanel>
                        </Border>

                        <Border Classes="selected-badge"
                                Width="20"
                                Height="20"
                                CornerRadius="10"
                                Background="{DynamicResource EditorBrush.Primary}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-4,-4,0">
                          <TextBlock Text="✓"
                                     Foreground="{DynamicResource EditorBrush.OnPrimary}"
                                     FontSize="12"
                                     FontWeight="Bold"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                        </Border>
                      </Grid>
                    </RadioButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </Expander>

          <Expander Header="{loc:Tr Dialog.LevelSettings.Background}"
                    IsExpanded="False"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
            <Border Padding="2,8,2,2">
              <ItemsControl ItemsSource="{Binding BackgroundOptions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BackgroundOption">
                    <RadioButton Classes="PickerCard"
                                 GroupName="Background"
                                 IsChecked="{Binding IsSelected, Mode=TwoWay}">

                      <Grid Width="150">
                        <Border Classes="card-surface"
                                Padding="8"
                                CornerRadius="10">
                          <StackPanel Spacing="7">

                            <Border Classes="preview-frame"
                                    Height="72"
                                    Background="{DynamicResource EditorBrush.Surface.Preview}"
                                    ClipToBounds="True"
                                    CornerRadius="7"
                                    HorizontalAlignment="Stretch">
                              <Panel>
                                <Image Source="{Binding Thumbnail}"
                                       Stretch="UniformToFill"
                                       IsVisible="{Binding !IsRandom}" />
                                <icons:MaterialIcon Kind="DiceMultiple"
                                                    Width="32"
                                                    Height="32"
                                                    Foreground="{DynamicResource EditorBrush.Text.Subtle}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding IsRandom}" />
                              </Panel>
                            </Border>

                            <TextBlock Text="{Binding Label}"
                                       FontSize="12"
                                       LineHeight="14"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       MinHeight="30" />

                          </StackPanel>
                        </Border>

                        <Border Classes="selected-badge"
                                Width="20"
                                Height="20"
                                CornerRadius="10"
                                Background="{DynamicResource EditorBrush.Primary}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-4,-4,0">
                          <TextBlock Text="✓"
                                     Foreground="{DynamicResource EditorBrush.OnPrimary}"
                                     FontSize="12"
                                     FontWeight="Bold"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                        </Border>
                      </Grid>
                    </RadioButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </Expander>

          <Expander Header="{loc:Tr Dialog.LevelSettings.CandySkin}"
                    IsExpanded="False"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
            <Border Padding="2,8,2,2">
              <ItemsControl ItemsSource="{Binding CandySkinOptions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CandySkinOption">
                    <RadioButton Classes="PickerCard"
                                 GroupName="CandySkin"
                                 IsChecked="{Binding IsSelected, Mode=TwoWay}">

                      <Grid Width="96">
                        <Border Classes="card-surface"
                                Padding="8"
                                CornerRadius="10">
                          <StackPanel Spacing="7">

                            <Border Classes="preview-frame"
                                    Height="60"
                                    CornerRadius="7"
                                    Background="{DynamicResource EditorBrush.Surface.Preview}"
                                    ClipToBounds="True">
                              <Panel>
                                <Image Source="{Binding Thumbnail}"
                                       Stretch="Uniform"
                                       Margin="6"
                                       IsVisible="{Binding !IsRandom}" />
                                <icons:MaterialIcon Kind="DiceMultiple"
                                                    Width="28"
                                                    Height="28"
                                                    Foreground="{DynamicResource EditorBrush.Text.Subtle}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding IsRandom}" />
                              </Panel>
                            </Border>

                            <TextBlock Text="{Binding Label}"
                                       FontSize="12"
                                       LineHeight="14"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       MinHeight="30" />

                          </StackPanel>
                        </Border>

                        <Border Classes="selected-badge"
                                Width="20"
                                Height="20"
                                CornerRadius="10"
                                Background="{DynamicResource EditorBrush.Primary}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-4,-4,0">
                          <TextBlock Text="✓"
                                     Foreground="{DynamicResource EditorBrush.OnPrimary}"
                                     FontSize="12"
                                     FontWeight="Bold"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                        </Border>
                      </Grid>
                    </RadioButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </Expander>

          <Expander Header="{loc:Tr Dialog.LevelSettings.OmNomSupport}"
                    IsExpanded="False"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
            <Border Padding="2,8,2,2">
              <ItemsControl ItemsSource="{Binding OmNomSupportOptions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:OmNomSupportOption">
                    <RadioButton Classes="PickerCard"
                                 GroupName="OmNomSupport"
                                 IsChecked="{Binding IsSelected, Mode=TwoWay}">

                      <Grid Width="96">
                        <Border Classes="card-surface"
                                Padding="8"
                                CornerRadius="10">
                          <StackPanel Spacing="7">

                            <Border Classes="preview-frame"
                                    Height="60"
                                    CornerRadius="7"
                                    Background="{DynamicResource EditorBrush.Surface.Preview}"
                                    ClipToBounds="True">
                              <Panel>
                                <Image Source="{Binding Thumbnail}"
                                       Stretch="Uniform"
                                       Margin="6"
                                       IsVisible="{Binding !IsRandom}" />
                                <icons:MaterialIcon Kind="DiceMultiple"
                                                    Width="28"
                                                    Height="28"
                                                    Foreground="{DynamicResource EditorBrush.Text.Subtle}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding IsRandom}" />
                              </Panel>
                            </Border>

                            <TextBlock Text="{Binding Label}"
                                       FontSize="12"
                                       LineHeight="14"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       MinHeight="30" />

                          </StackPanel>
                        </Border>

                        <Border Classes="selected-badge"
                                Width="20"
                                Height="20"
                                CornerRadius="10"
                                Background="{DynamicResource EditorBrush.Primary}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-4,-4,0">
                          <TextBlock Text="✓"
                                     Foreground="{DynamicResource EditorBrush.OnPrimary}"
                                     FontSize="12"
                                     FontWeight="Bold"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                        </Border>
                      </Grid>
                    </RadioButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </Expander>

          <CheckBox Content="{loc:Tr Dialog.LevelSettings.RememberCustomizationChoice}"
                    IsVisible="{Binding ShowRememberDecoration}"
                    IsChecked="{Binding RememberDecoration, Mode=TwoWay}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2"
          ColumnDefinitions="*,Auto,Auto"
          Margin="0,12,0,0">
      <Button Grid.Column="1"
              Content="{loc:Tr Dialog.Common.Cancel}"
              Click="Cancel_Click"
              Margin="0,0,8,0" />

      <Button Grid.Column="2"
              x:Name="ConfirmButton"
              Click="Confirm_Click"
              Classes="accent"
              IsEnabled="{Binding CanConfirm}" />
    </Grid>
  </Grid>
</UserControl>
