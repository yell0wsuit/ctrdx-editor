<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CtrDxEditor.ViewModels"
             xmlns:loc="using:CtrDxEditor.Localization"
             xmlns:ctrl="using:CtrDxEditor.Controls"
             x:Class="CtrDxEditor.Views.LevelSettingsDialog"
             x:DataType="vm:LevelSettingsViewModel">

  <UserControl.Styles>
    <Style Selector="RadioButton.PickerCard">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />

      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- Base card surface. -->
    <Style Selector="RadioButton.PickerCard Border.card-surface">
      <Setter Property="Background" Value="#14FFFFFF" />
      <Setter Property="BorderBrush" Value="#22FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Hover state. -->
    <Style Selector="RadioButton.PickerCard:pointerover Border.card-surface">
      <Setter Property="Background" Value="#20FFFFFF" />
      <Setter Property="BorderBrush" Value="#55FFFFFF" />
    </Style>

    <!-- Pressed state. -->
    <Style Selector="RadioButton.PickerCard:pressed Border.card-surface">
      <Setter Property="Background" Value="#28FFFFFF" />
    </Style>

    <!-- Selected state. -->
    <Style Selector="RadioButton.PickerCard:checked Border.card-surface">
      <Setter Property="Background" Value="#220078D7" />
      <Setter Property="BorderBrush" Value="#FF0078D7" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- Hidden by default; shown only on checked cards. -->
    <Style Selector="RadioButton.PickerCard Border.selected-badge">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="RadioButton.PickerCard:checked Border.selected-badge">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Slightly brighten preview when hovering. -->
    <Style Selector="RadioButton.PickerCard:pointerover Border.preview-frame">
      <Setter Property="Opacity" Value="0.95" />
    </Style>

  </UserControl.Styles>

  <Grid Margin="24" Width="360" MaxHeight="640" RowDefinitions="Auto,*,Auto">
    <TextBlock x:Name="TitleText"
               Grid.Row="0"
               FontSize="18"
               FontWeight="SemiBold"
               Margin="0,0,0,12" />

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="12">

        <StackPanel Spacing="4">
          <TextBlock Text="{loc:Tr Dialog.LevelSettings.Resolution}" />

          <ComboBox ItemsSource="{Binding Presets}"
                    SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ResolutionPreset">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <!-- The manual W×H inputs only appear when the "Custom…" preset is selected. -->
          <Grid ColumnDefinitions="*,Auto,*"
                RowDefinitions="Auto,Auto"
                Margin="0,4,0,0"
                IsVisible="{Binding IsCustom}">
            <NumericUpDown Grid.Row="0"
                           Grid.Column="0"
                           Minimum="320"
                           Maximum="9999"
                           Increment="1"
                           FormatString="0"
                           Value="{Binding CustomWidth, Mode=TwoWay}" />

            <TextBlock Grid.Row="0"
                       Grid.Column="1"
                       Text="x"
                       VerticalAlignment="Center"
                       Margin="8,0" />

            <NumericUpDown Grid.Row="0"
                           Grid.Column="2"
                           Minimum="480"
                           Maximum="9999"
                           Increment="1"
                           FormatString="0"
                           Value="{Binding CustomHeight, Mode=TwoWay}" />

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="{loc:Tr Dialog.LevelSettings.EnterNumber}"
                       Foreground="#E06C75"
                       FontSize="12"
                       Margin="0,2,0,0"
                       IsVisible="{Binding CustomWidth, Converter={x:Static ObjectConverters.IsNull}}" />

            <TextBlock Grid.Row="1"
                       Grid.Column="2"
                       Text="{loc:Tr Dialog.LevelSettings.EnterNumber}"
                       Foreground="#E06C75"
                       FontSize="12"
                       Margin="0,2,0,0"
                       IsVisible="{Binding CustomHeight, Converter={x:Static ObjectConverters.IsNull}}" />
          </Grid>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="{loc:Tr Dialog.LevelSettings.RopePhysicsSpeed}" />

          <!-- Negatives are permitted (DX parses them without clamping), though only positive speeds are meaningful. -->
          <NumericUpDown Minimum="-100"
                         Maximum="100"
                         Increment="0.1"
                         FormatString="0.0#"
                         Value="{Binding RopePhysicsSpeed, Mode=TwoWay}" />

          <TextBlock Text="{loc:Tr Dialog.LevelSettings.EnterNumber}"
                     Foreground="#E06C75"
                     FontSize="12"
                     IsVisible="{Binding RopePhysicsSpeed, Converter={x:Static ObjectConverters.IsNull}}" />
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="{loc:Tr Dialog.LevelSettings.Special}"
                     ToolTip.Tip="{loc:Tr Dialog.LevelSettings.SpecialTooltip}" />

          <ComboBox ItemsSource="{Binding SpecialOptions}"
                    SelectedItem="{Binding SelectedSpecial, Mode=TwoWay}"
                    HorizontalAlignment="Stretch"
                    ToolTip.Tip="{loc:Tr Dialog.LevelSettings.SpecialTooltip}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SpecialOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <!-- The manual value input only appears when the "Custom…" option is selected. -->
          <StackPanel Spacing="2"
                      IsVisible="{Binding IsSpecialCustom}">
            <NumericUpDown Minimum="0"
                           Maximum="99"
                           Increment="1"
                           FormatString="0"
                           Value="{Binding CustomSpecial, Mode=TwoWay}" />

            <TextBlock Text="{loc:Tr Dialog.LevelSettings.EnterNumber}"
                       Foreground="#E06C75"
                       FontSize="12"
                       IsVisible="{Binding CustomSpecial, Converter={x:Static ObjectConverters.IsNull}}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Spacing="4">
          <CheckBox Content="{loc:Tr Dialog.LevelSettings.HalfCandy}"
                    IsChecked="{Binding TwoParts, Mode=TwoWay}"
                    IsEnabled="{Binding FlagsEditable}">
            <ToolTip.Tip>
              <StackPanel MaxWidth="260">
                <TextBlock Text="{loc:Tr Dialog.LevelSettings.HalfCandyDescription}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </ToolTip.Tip>
          </CheckBox>

          <CheckBox Content="{loc:Tr Dialog.LevelSettings.NightLevel}"
                    IsChecked="{Binding NightLevel, Mode=TwoWay}"
                    IsEnabled="{Binding FlagsEditable}">
            <ToolTip.Tip>
              <StackPanel MaxWidth="260">
                <TextBlock Text="{loc:Tr Dialog.LevelSettings.NightLevelDescription}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </ToolTip.Tip>
          </CheckBox>

          <CheckBox Content="{loc:Tr Dialog.LevelSettings.MobilePhysics}"
                    IsChecked="{Binding UseMobilePhysics, Mode=TwoWay}"
                    IsEnabled="{Binding FlagsEditable}">
            <ToolTip.Tip>
              <StackPanel MaxWidth="260">
                <TextBlock Text="{loc:Tr Dialog.LevelSettings.MobilePhysicsDescription}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </ToolTip.Tip>
          </CheckBox>
        </StackPanel>

        <!-- Editor-decoration pickers, shown in both New and Edit modes. -->
        <StackPanel Spacing="8">

          <Border Height="1"
                  Background="#22FFFFFF"
                  Margin="0,8,0,4" />

          <TextBlock Text="{loc:Tr Dialog.LevelSettings.CustomizationOptions}"
                      FontSize="16"
                      FontWeight="SemiBold"
                      Opacity="0.9"
                      Margin="0,0,0,2" />

          <Expander Header="{loc:Tr Dialog.LevelSettings.RopeColor}"
                    IsExpanded="False"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
            <Border Padding="2,8,2,2">
              <ItemsControl ItemsSource="{Binding RopeSkinOptions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RopeSkinOption">
                    <RadioButton Classes="PickerCard"
                                 GroupName="RopeSkin"
                                 IsChecked="{Binding IsSelected, Mode=TwoWay}">

                      <Grid Width="96">
                        <Border Classes="card-surface"
                                Padding="8"
                                CornerRadius="10">
                          <StackPanel Spacing="7">

                            <Border Classes="preview-frame"
                                    Height="36"
                                    CornerRadius="7"
                                    Background="#252525"
                                    ClipToBounds="True">
                              <ctrl:RopeSwatch Width="76"
                                                Height="28"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Skin="{Binding Id}" />
                            </Border>

                            <TextBlock Text="{Binding Label}"
                                       FontSize="12"
                                       LineHeight="14"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       MinHeight="30" />

                          </StackPanel>
                        </Border>

                        <Border Classes="selected-badge"
                                Width="20"
                                Height="20"
                                CornerRadius="10"
                                Background="#FF0078D7"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-4,-4,0">
                          <TextBlock Text="✓"
                                     Foreground="White"
                                     FontSize="12"
                                     FontWeight="Bold"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                        </Border>
                      </Grid>
                    </RadioButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </Expander>

          <Expander Header="{loc:Tr Dialog.LevelSettings.Background}"
                    IsExpanded="False"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
            <Border Padding="2,8,2,2">
              <ItemsControl ItemsSource="{Binding BackgroundOptions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BackgroundOption">
                    <RadioButton Classes="PickerCard"
                                 GroupName="Background"
                                 IsChecked="{Binding IsSelected, Mode=TwoWay}">

                      <Grid Width="150">
                        <Border Classes="card-surface"
                                Padding="8"
                                CornerRadius="10">
                          <StackPanel Spacing="7">

                            <Border Classes="preview-frame"
                                    Height="72"
                                    Background="#222"
                                    ClipToBounds="True"
                                    CornerRadius="7"
                                    HorizontalAlignment="Stretch">
                              <Image Source="{Binding Thumbnail}"
                                     Stretch="UniformToFill" />
                            </Border>

                            <TextBlock Text="{Binding Label}"
                                       FontSize="12"
                                       LineHeight="14"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       MinHeight="30" />

                          </StackPanel>
                        </Border>

                        <Border Classes="selected-badge"
                                Width="20"
                                Height="20"
                                CornerRadius="10"
                                Background="#FF0078D7"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-4,-4,0">
                          <TextBlock Text="✓"
                                     Foreground="White"
                                     FontSize="12"
                                     FontWeight="Bold"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                        </Border>
                      </Grid>
                    </RadioButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </Expander>

          <Expander Header="{loc:Tr Dialog.LevelSettings.CandySkin}"
                    IsExpanded="False"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
            <Border Padding="2,8,2,2">
              <ItemsControl ItemsSource="{Binding CandySkinOptions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CandySkinOption">
                    <RadioButton Classes="PickerCard"
                                 GroupName="CandySkin"
                                 IsChecked="{Binding IsSelected, Mode=TwoWay}">

                      <Grid Width="96">
                        <Border Classes="card-surface"
                                Padding="8"
                                CornerRadius="10">
                          <StackPanel Spacing="7">

                            <Border Classes="preview-frame"
                                    Height="60"
                                    CornerRadius="7"
                                    Background="#252525"
                                    ClipToBounds="True">
                              <Image Source="{Binding Thumbnail}"
                                     Stretch="Uniform"
                                     Margin="6" />
                            </Border>

                            <TextBlock Text="{Binding Label}"
                                       FontSize="12"
                                       LineHeight="14"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       MinHeight="30" />

                          </StackPanel>
                        </Border>

                        <Border Classes="selected-badge"
                                Width="20"
                                Height="20"
                                CornerRadius="10"
                                Background="#FF0078D7"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-4,-4,0">
                          <TextBlock Text="✓"
                                     Foreground="White"
                                     FontSize="12"
                                     FontWeight="Bold"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                        </Border>
                      </Grid>
                    </RadioButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </Expander>

          <CheckBox Content="{loc:Tr Dialog.LevelSettings.RememberCustomizationChoice}"
                    IsVisible="{Binding ShowRememberDecoration}"
                    IsChecked="{Binding RememberDecoration, Mode=TwoWay}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2"
          ColumnDefinitions="*,Auto,Auto"
          Margin="0,12,0,0">
      <Button Grid.Column="1"
              Content="{loc:Tr Dialog.Common.Cancel}"
              Click="Cancel_Click"
              Margin="0,0,8,0" />

      <Button Grid.Column="2"
              x:Name="ConfirmButton"
              Click="Confirm_Click"
              Classes="accent"
              IsEnabled="{Binding CanConfirm}" />
    </Grid>
  </Grid>
</UserControl>
