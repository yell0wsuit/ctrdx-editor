<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:CtrDxEditor.Localization"
             xmlns:conv="using:CtrDxEditor.Converters"
             xmlns:views="using:CtrDxEditor.Views"
             x:Class="CtrDxEditor.Views.MessageDialog"
             x:CompileBindings="True"
             x:DataType="views:MessageDialog">
  <UserControl.Styles>
    <Style Selector="TextBlock.dialog-header.danger">
      <Setter Property="Foreground" Value="{DynamicResource EditorBrush.DangerText}" />
    </Style>
  </UserControl.Styles>
  <!-- Clamped MaxHeight + scrolling message row, so a long message never pushes OK off-screen. -->
  <Grid Margin="24" RowDefinitions="Auto,*,Auto"
        Width="{Binding $parent[TopLevel].Bounds.Width,
                Converter={x:Static conv:DialogSizeConverter.Clamp}, ConverterParameter=460}"
        MaxHeight="{Binding $parent[TopLevel].Bounds.Height,
                    Converter={x:Static conv:DialogSizeConverter.Clamp}, ConverterParameter=640}">
    <TextBlock Grid.Row="0" Margin="0,0,0,16"
               Classes="dialog-header" Classes.danger="{Binding IsDanger}"
               FontSize="18" FontWeight="SemiBold" Text="{Binding Header}" />
    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <TextBlock TextWrapping="Wrap" Text="{Binding Message}" />
    </ScrollViewer>
    <Button Grid.Row="2" Margin="0,16,0,0"
            Content="{loc:Tr Dialog.Common.Ok}" Click="Ok_Click" HorizontalAlignment="Right" />
  </Grid>
</UserControl>
