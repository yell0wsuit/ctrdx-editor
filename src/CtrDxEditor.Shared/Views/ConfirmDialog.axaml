<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:CtrDxEditor.Views"
             xmlns:conv="using:CtrDxEditor.Converters"
             x:Class="CtrDxEditor.Views.ConfirmDialog"
             x:CompileBindings="True"
             x:DataType="views:ConfirmDialog">
  <!-- Clamped MaxHeight + scrolling message row: a long body (e.g. many validation warnings) would
       otherwise grow past the window and push the buttons off-screen with no way to reach them. -->
  <Grid Margin="24" RowDefinitions="Auto,*,Auto"
        Width="{Binding $parent[TopLevel].Bounds.Width,
                Converter={x:Static conv:DialogSizeConverter.Clamp}, ConverterParameter=380}"
        MaxHeight="{Binding $parent[TopLevel].Bounds.Height,
                    Converter={x:Static conv:DialogSizeConverter.Clamp}, ConverterParameter=640}">
    <TextBlock Grid.Row="0" Margin="0,0,0,16"
               FontSize="18" FontWeight="SemiBold" Text="{Binding Header}" />
    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <TextBlock TextWrapping="Wrap" Text="{Binding Message}" />
    </ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,16,0,0"
                Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="{Binding NegativeText}" Click="Cancel_Click"
              MinWidth="96" Padding="16,6"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center" />
      <Button Classes.danger="{Binding IsDestructive}" Content="{Binding PositiveText}" Click="Confirm_Click"
              MinWidth="96" Padding="16,6"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center" />
    </StackPanel>
  </Grid>
</UserControl>
