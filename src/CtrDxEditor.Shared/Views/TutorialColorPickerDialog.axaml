<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:CtrDxEditor.Views"
             xmlns:conv="using:CtrDxEditor.Converters"
             xmlns:loc="using:CtrDxEditor.Localization"
             x:Class="CtrDxEditor.Views.TutorialColorPickerDialog"
             x:CompileBindings="True"
             x:DataType="views:TutorialColorPickerDialog">
  <Grid Margin="24" RowDefinitions="Auto,*,Auto" RowSpacing="16"
        Width="420"
        MaxWidth="{Binding $parent[TopLevel].Bounds.Width,
                   Converter={x:Static conv:DialogSizeConverter.Clamp}, ConverterParameter=420}"
        MaxHeight="{Binding $parent[TopLevel].Bounds.Height,
                    Converter={x:Static conv:DialogSizeConverter.Clamp}, ConverterParameter=680}">
    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock FontSize="18" FontWeight="SemiBold" Text="{loc:Tr Dialog.ColorPicker.Title}" />
      <TextBlock Text="{Binding Guidance}" TextWrapping="Wrap"
                 Foreground="{DynamicResource EditorBrush.Text.Subtle}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ColorView x:Name="Picker"
                 IsEnabled="{Binding CanApplyCustomColor}"
                 IsAlphaEnabled="False"
                 IsAlphaVisible="False"
                 IsAccentColorsVisible="False" />
    </ScrollViewer>

    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
      <Button Grid.Column="0" Content="{loc:Tr Dialog.ColorPicker.UseDefault}"
              Click="UseDefault_Click" Padding="16,6" />
      <Button Grid.Column="2" Content="{loc:Tr Dialog.Common.Cancel}"
              Click="Cancel_Click" Padding="16,6" />
      <Button Grid.Column="3" Content="{loc:Tr Dialog.ColorPicker.Apply}"
              Click="Apply_Click" IsEnabled="{Binding CanApplyCustomColor}" Padding="16,6" />
    </Grid>
  </Grid>
</UserControl>
