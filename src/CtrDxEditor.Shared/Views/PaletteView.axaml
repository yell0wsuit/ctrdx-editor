<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CtrDxEditor.ViewModels"
        xmlns:loc="using:CtrDxEditor.Localization"
        xmlns:ctl="using:CtrDxEditor.Controls"
        xmlns:icons="using:Material.Icons.Avalonia"
        x:Class="CtrDxEditor.Views.PaletteView"
        x:DataType="vm:EditorViewModel">
  <Border Background="{DynamicResource EditorBrush.Surface.Panel}">
    <Grid RowDefinitions="Auto,*">
      <TextBox Grid.Row="0" Margin="6,6,6,4"
               IsVisible="{Binding HasDocument, FallbackValue=False}"
               Text="{Binding PaletteSearchText, Mode=TwoWay}"
               PlaceholderText="{loc:Tr Palette.SearchPlaceholder}">
        <TextBox.InnerLeftContent>
          <icons:MaterialIcon Kind="Magnify" Width="16" Height="16" Margin="6,0,0,0"
                              Foreground="{DynamicResource EditorBrush.Text.Subtle}" />
        </TextBox.InnerLeftContent>
      </TextBox>
      <Grid Grid.Row="1">
        <ScrollViewer x:Name="PaletteScroll" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      ScrollChanged="OnPaletteScrollChanged">
          <ItemsControl x:Name="PaletteList" ItemsSource="{Binding PaletteView}" Margin="6,0,6,10">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <Border IsVisible="{Binding ShowDivider}" Height="1" Margin="0,8,0,0"
                          Background="{DynamicResource EditorBrush.Surface.Divider}" />
                  <TextBlock Text="{Binding GroupName}" FontWeight="Bold"
                             IsVisible="{Binding ShowGroupHeader}"
                             TextWrapping="Wrap" Margin="2,8,2,4" />
                  <Button Margin="0,3" Padding="8,6" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          IsEnabled="{Binding Enabled}"
                          Classes.placed="{Binding JustPlaced}"
                          Tag="{Binding Element}">
                    <Grid ColumnDefinitions="*,Auto">
                      <ctl:MarqueeTextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                            ForceActive="{Binding IsDragging}"
                                            VerticalAlignment="Center" />
                      <Grid Grid.Column="1" Width="28" Height="28" Margin="6,0,0,0">
                        <!-- The whole icon stack hides together: the dark-theme overlay is masked by the
                             icon, so hiding only the Image would leave its silhouette over the check. -->
                        <Grid IsVisible="{Binding !JustPlaced}">
                          <Image Source="{Binding Icon}" Stretch="Uniform" />
                          <Border IsVisible="{Binding InvertOnDarkTheme}"
                                  Background="{DynamicResource EditorBrush.TutorialPaletteOverlay}">
                            <Border.OpacityMask>
                              <ImageBrush Source="{Binding Icon}" Stretch="Uniform" />
                            </Border.OpacityMask>
                          </Border>
                        </Grid>
                        <icons:MaterialIcon Kind="CheckCircle" Width="22" Height="22"
                                            IsVisible="{Binding JustPlaced}"
                                            Foreground="{DynamicResource EditorBrush.SuccessText}" />
                      </Grid>
                    </Grid>
                  </Button>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <!-- Sticky overlay header: pinned at the top of the scroll area, text updated on scroll. -->
        <Border x:Name="StickyHeaderHost" VerticalAlignment="Top" IsHitTestVisible="False"
                Background="{DynamicResource EditorBrush.Surface.Panel}"
                Padding="8,6" IsVisible="False">
          <TextBlock x:Name="StickyHeaderText" FontWeight="Bold" TextWrapping="Wrap" />
        </Border>
      </Grid>
    </Grid>
  </Border>
</UserControl>
