<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:CtrDxEditor.Views"
             xmlns:loc="using:CtrDxEditor.Localization"
             xmlns:icons="using:Material.Icons.Avalonia"
             x:Class="CtrDxEditor.Views.UsageGuideDialog">
  <Grid Width="{Binding $parent[TopLevel].Bounds.Width}"
        Height="{Binding $parent[TopLevel].Bounds.Height}">
    <views:UsageGuideView />
    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
            Width="40" Height="40" Margin="8" Padding="0"
            Click="Close_Click" ToolTip.Tip="{loc:Tr Dialog.Common.Close}">
      <icons:MaterialIcon Kind="Close" Width="20" Height="20" />
    </Button>
  </Grid>
</UserControl>
