<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:CtrDxEditor.Localization"
             xmlns:vm="using:CtrDxEditor.ViewModels"
             xmlns:core="using:CtrDxEditor.Core.Editing"
             xmlns:controls="using:CtrDxEditor.Controls"
             x:Class="CtrDxEditor.Views.ReviewChangesDialog"
             x:CompileBindings="True"
             x:DataType="vm:ReviewChangesViewModel">
  <UserControl.Resources>
    <FontFamily x:Key="DiffFontFamily">avares://CtrDxEditor.Shared/Assets/Fonts#Roboto Mono</FontFamily>
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- The list is a read-only diff, so strip the ListBox's selection and hover affordances. -->
    <Style Selector="ListBox.diff > ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.diff > ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.diff > ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- Unified rows are single-sided by construction, so the whole row takes one tint. -->
    <Style Selector="Border.row.added">
      <Setter Property="Background" Value="{DynamicResource EditorBrush.Diff.Added}" />
    </Style>
    <Style Selector="Border.row.removed">
      <Setter Property="Background" Value="{DynamicResource EditorBrush.Diff.Removed}" />
    </Style>
    <!-- Split panes are tinted independently: a modified line is a deletion on the left beside an
         insertion on the right, so red and green carry every change and no third colour is needed. -->
    <Style Selector="Border.side.removed">
      <Setter Property="Background" Value="{DynamicResource EditorBrush.Diff.Removed}" />
    </Style>
    <Style Selector="Border.side.added">
      <Setter Property="Background" Value="{DynamicResource EditorBrush.Diff.Added}" />
    </Style>
    <Style Selector="TextBlock.gutter">
      <Setter Property="Foreground" Value="{DynamicResource EditorBrush.Diff.Gutter}" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="FontFamily" Value="{StaticResource DiffFontFamily}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="LineHeight" Value="18" />
    </Style>
    <Style Selector="TextBlock.code">
      <Setter Property="FontFamily" Value="{StaticResource DiffFontFamily}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="LineHeight" Value="18" />
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Intra-line highlight, matched to the row tint: the characters that actually changed are
         painted a step darker than the row they sit on. Unchanged rows leave the brush unset, so
         their runs render flat. -->
    <Style Selector="Border.row.added TextBlock.code, Border.side.added TextBlock.code">
      <Setter Property="controls:DiffTextBlock.HighlightBrush" Value="{DynamicResource EditorBrush.Diff.AddedStrong}" />
    </Style>
    <Style Selector="Border.row.removed TextBlock.code, Border.side.removed TextBlock.code">
      <Setter Property="controls:DiffTextBlock.HighlightBrush" Value="{DynamicResource EditorBrush.Diff.RemovedStrong}" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="24" MaxWidth="900" MaxHeight="640" HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch" RowDefinitions="Auto,Auto,*,Auto">
    <!-- Title and the split/unified toggle -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0" Classes="dialog-header" FontSize="18" FontWeight="SemiBold"
                 VerticalAlignment="Center" Text="{loc:Tr Dialog.Review.Title}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
        <RadioButton GroupName="DiffView" Content="{loc:Tr Dialog.Review.Split}"
                     IsChecked="{Binding IsSplitView, Mode=TwoWay}" />
        <RadioButton GroupName="DiffView" Content="{loc:Tr Dialog.Review.Unified}"
                     IsChecked="{Binding IsUnifiedView, Mode=OneWay}" />
      </StackPanel>
    </Grid>

    <TextBlock Grid.Row="1" Margin="0,4,0,12" Text="{Binding Summary}"
               IsVisible="{Binding HasChanges}"
               Foreground="{DynamicResource EditorBrush.Text.Subtle}" />

    <!-- Empty state -->
    <TextBlock Grid.Row="2" Margin="0,48" HorizontalAlignment="Center" VerticalAlignment="Center"
               IsVisible="{Binding !HasChanges}"
               Foreground="{DynamicResource EditorBrush.Text.Subtle}"
               Text="{loc:Tr Dialog.Review.NoChanges}" />

    <!-- Split view: old gutter, old text, new gutter, new text -->
    <Border Grid.Row="2" BorderThickness="1" CornerRadius="4"
            BorderBrush="{DynamicResource EditorBrush.Surface.Divider}"
            Background="{DynamicResource EditorBrush.Surface.Card}">
      <Border.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="HasChanges" />
          <Binding Path="IsSplitView" />
        </MultiBinding>
      </Border.IsVisible>
      <ListBox Classes="diff" ItemsSource="{Binding Rows}" Background="Transparent" Padding="8"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="core:DiffRow">
            <Grid ColumnDefinitions="*,*">
              <Border Grid.Column="0" Classes="side" Classes.removed="{Binding OldSideChanged}">
                <Grid ColumnDefinitions="44,*">
                  <TextBlock Grid.Column="0" Classes="gutter" Text="{Binding OldLine}" />
                  <TextBlock Grid.Column="1" Classes="code" controls:DiffTextBlock.Runs="{Binding OldRuns}" />
                </Grid>
              </Border>
              <Border Grid.Column="1" Classes="side" Classes.added="{Binding NewSideChanged}">
                <Grid ColumnDefinitions="44,*">
                  <TextBlock Grid.Column="0" Classes="gutter" Text="{Binding NewLine}" />
                  <TextBlock Grid.Column="1" Classes="code" controls:DiffTextBlock.Runs="{Binding NewRuns}" />
                </Grid>
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- Unified view: line numbers, marker, text -->
    <Border Grid.Row="2" BorderThickness="1" CornerRadius="4"
            BorderBrush="{DynamicResource EditorBrush.Surface.Divider}"
            Background="{DynamicResource EditorBrush.Surface.Card}">
      <Border.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="HasChanges" />
          <Binding Path="IsUnifiedView" />
        </MultiBinding>
      </Border.IsVisible>
      <ListBox Classes="diff" ItemsSource="{Binding UnifiedRows}" Background="Transparent" Padding="8"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="core:UnifiedDiffRow">
            <Border Classes="row"
                    Classes.added="{Binding IsAdded}"
                    Classes.removed="{Binding IsRemoved}">
              <Grid ColumnDefinitions="44,44,16,*">
                <TextBlock Grid.Column="0" Classes="gutter" Text="{Binding OldLine}" />
                <TextBlock Grid.Column="1" Classes="gutter" Text="{Binding NewLine}" />
                <TextBlock Grid.Column="2" Classes="code" Text="{Binding Marker}" />
                <TextBlock Grid.Column="3" Classes="code" controls:DiffTextBlock.Runs="{Binding Runs}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Button Grid.Row="3" Margin="0,16,0,0" HorizontalAlignment="Right"
            Content="{loc:Tr Dialog.Common.Close}" Click="Close_Click" />
  </Grid>
</UserControl>
