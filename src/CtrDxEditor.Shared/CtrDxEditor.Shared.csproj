<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>CtrDxEditor</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AvaloniaNameGeneratorIsEnabled>false</AvaloniaNameGeneratorIsEnabled>
    <!-- App has no public parameterless ctor by design (PlatformStartup is injected); it is
         never loaded via the XAML runtime/previewer loader, so AVLN3001 does not apply here. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaDialogs" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Material.Icons.Avalonia" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CtrDxEditor.Core\CtrDxEditor.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Translations are embedded as Avalonia resources so they load on every platform (incl. browser). -->
    <AvaloniaResource Include="Localization\*.json" />
  </ItemGroup>
</Project>
