{
    "id": "./",
    "name": "Cut the Rope DX: Level Editor",
    "short_name": "CTRDX Editor",
    "description": "Create and edit custom Cut the Rope DX levels.",
    "start_url": "./",
    "scope": "./",
    "display": "standalone",
    "launch_handler": {
        "client_mode": "focus-existing"
    },
    "background_color": "#202329",
    "theme_color": "#202329",
    "icons": [
        {
            "src": "./icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        }
    ],
    "screenshots": [
