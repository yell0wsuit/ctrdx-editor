        },
        {
            "src": "./screenshots/landscape_ss_02.webp",
            "sizes": "2940x1846",
            "type": "image/webp",
            "form_factor": "wide",
            "label": "The level settings dialog"
        },
        {
            "src": "./screenshots/landscape_ss_03.webp",
            "sizes": "2940x1846",
            "type": "image/webp",
            "form_factor": "wide",
            "label": "The built-in usage guide, with a searchable table of contents"
        },
        {
            "src": "./screenshots/portrait_ss_01.webp",
            "sizes": "662x1434",
            "type": "image/webp",
            "form_factor": "narrow",
